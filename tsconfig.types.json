{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "allowJs": false,
        "jsx": "react-jsx",
        "types": [
            "react"
        ]
    },
    "include": [
        "src/**/*.d.ts",
        "tests/types/**/*.ts",
        "tests/types/**/*.tsx"
    ]
}
