    },
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.0.0",
        "@types/react": "^18.3.31",
        "ctg-js-test": "github:claymoretechgroup/ctg-js-test#v4.0.0",
        "ctg-react-test": "github:claymoretechgroup/ctg-react-test#v4.0.0",
        "jsdom": "^24.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "form-data": "4.0.6",
        "react-test-renderer": "18.3.1",
        "ws": "8.21.3"
    },
    "types": "./src/types/index.d.ts"
