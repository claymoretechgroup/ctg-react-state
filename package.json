{
    "name": "ctg-react-state",
    "version": "2.0.0",
    "description": "Lightweight distributed state management for React built on useState reactivity",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/types/index.d.ts",
            "default": "./src/index.js"
        }
    },
    "scripts": {
        "test": "node --import ctg-react-test/jsx-loader tests/SelfTest.js",
